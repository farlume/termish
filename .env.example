# Termish release 签名机密模板
# 用法：cp .env.example .env 并填入真实值（.env 与 *.jks 已 gitignore）
# 留底位置：~/Documents/秘钥/termish-release.env + termish-release.jks
#
# 变量名与 GitHub Actions Secrets 完全一致（见 .github/workflows/build.yml）。
# build.gradle.kts 读取优先级：进程环境变量 > secrets/.env > keystore.properties（兼容）

# 密钥库密码（keytool 生成 jks 时设置）
ANDROID_KEYSTORE_PASSWORD=

# 密钥别名（与 keystore 中 keytool -alias 指定的条目名一致即可）
# 注意：别名仅作 keystore 内部索引，不影响已签名包的校验；
# 真正不可变的是私钥本身——对外发布过任何包后更换私钥会导致老用户无法覆盖安装
ANDROID_KEY_ALIAS=termish

# 别名密码（可与密钥库密码相同）
ANDROID_KEY_PASSWORD=

# termish-release.jks 的 base64 编码（jks 文件缺失时构建脚本自动解码使用）
# 生成：base64 -i termish-release.jks | tr -d '\n'
ANDROID_KEYSTORE_BASE64=
