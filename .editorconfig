# 代码风格基线（编辑器/工具统一；ktlint 计划于仓库公开前接入）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# import 按字母序（IDE 自动整理，与 Kotlin 官方风格一致）
ij_kotlin_imports_layout = *

[*.{md,yaml,yml,json}]
indent_size = 2

[Makefile]
indent_style = tab
